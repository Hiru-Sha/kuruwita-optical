# ============================================================
#  KURUWITA OPTICAL — Backend Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER share or upload your .env file!
# ============================================================

# Database (from Supabase → Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret — make this a long random string (at least 32 characters)
JWT_SECRET=kuruwita-optical-super-secret-key-change-this-2024

# Server port
PORT=5000

# Frontend URL (for CORS — your Vercel URL after deploy)
FRONTEND_URL=https://kuruwita-optical.vercel.app
